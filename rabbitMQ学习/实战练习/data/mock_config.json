{
  "_note": "模拟第三方网关行为与故障注入。练习中不要改代码来制造故障，只改这个文件。",

  "gateway": {
    "_note": "send_seconds：模拟调用第三方网关的耗时，用 sleep 实现。rate_limit_per_sec：网关允许的最大发送速率，超过要靠消费端自己压住。",
    "sms":   { "send_seconds": 0.5, "rate_limit_per_sec": 5 },
    "email": { "send_seconds": 1.0, "rate_limit_per_sec": 2 },
    "inapp": { "send_seconds": 0.1, "rate_limit_per_sec": 50 }
  },

  "fail_rules": [
    {
      "_note": "前两次调用抛临时错误，第三次成功——验证有限重试后能恢复",
      "request_id": "REQ-0010",
      "channel": "sms",
      "mode": "fail_times",
      "times": 2,
      "error": "GatewayTimeout: upstream sms provider timeout"
    },
    {
      "_note": "每次都抛临时错误——验证重试耗尽后进死信",
      "request_id": "REQ-0011",
      "channel": "email",
      "mode": "fail_always",
      "error": "SMTPConnectError: connection refused"
    }
  ],

  "batch": {
    "_note": "练习三/四用的压测批次参数，用 for 循环按这里的数量生成，不要写死在代码里",
    "marketing_count": 30,
    "verify_code_count": 3,
    "concurrent_orders": 20
  },

  "consumer": {
    "_note": "消费端可调开关，改这里观察行为差异",
    "prefetch_count": 1,
    "pause_before_ack_seconds": 0,
    "pause_after_send_seconds": 0
  },

  "retry": {
    "_note": "重试阶梯，单位秒；长度即最大重试次数",
    "backoff_seconds": [5, 15, 60]
  }
}
